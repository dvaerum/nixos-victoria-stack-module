+type recordedRequest struct {
+	path   string
+	header http.Header
+}
+
+func newRecordingBackend(t *testing.T) (*httptest.Server, func() []recordedRequest) {
+	t.Helper()
+	var mu sync.Mutex
+	var seen []recordedRequest
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		seen = append(seen, recordedRequest{path: r.URL.Path, header: r.Header.Clone()})
+		mu.Unlock()
+		_, _ = w.Write([]byte(`{"status":"success","data":{"resultType":"vector","result":[]}}`))
+	}))
+	t.Cleanup(ts.Close)
+	return ts, func() []recordedRequest {
+		mu.Lock()
+		defer mu.Unlock()
+		return append([]recordedRequest(nil), seen...)
+	}
+}
+
+func TestToolHandlersSendTenantHeadersToInstance(t *testing.T) {
+	ts, requests := newRecordingBackend(t)
+	cfg := newTenantTestConfig(t, ts.URL, "single", "Authorization")
+
+	call := func(args map[string]any) *mcp.CallToolResult {
+		tcr := mcp.CallToolRequest{}
+		tcr.Header = http.Header{"Authorization": {"Bearer client-token"}}
+		tcr.Params.Arguments = args
+		res, err := toolQueryHandler(context.Background(), cfg, tcr)
+		if err != nil {
+			t.Fatalf("handler error: %v", err)
+		}
+		return res
+	}
+
+	if res := call(map[string]any{"query": "up", "tenant": "3:7"}); res.IsError {
+		t.Fatalf("expected success, got %v", res.Content)
+	}
+	got := requests()
+	if len(got) != 1 {
+		t.Fatalf("expected 1 request, got %d", len(got))
+	}
+	if got[0].header.Get("AccountID") != "3" || got[0].header.Get("ProjectID") != "7" {
+		t.Errorf("tenant headers not sent: %v", got[0].header)
+	}
+	if got[0].header.Get("Authorization") != "Bearer client-token" {
+		t.Errorf("forwarded Authorization lost: %v", got[0].header)
+	}
+
+	for _, bad := range []any{"x/../y", "a:b", float64(1)} {
+		if res := call(map[string]any{"query": "up", "tenant": bad}); !res.IsError {
+			t.Errorf("tenant %v: expected an error result", bad)
+		}
+	}
+	if n := len(requests()); n != 1 {
+		t.Errorf("refused tenants must not reach the instance: %d requests seen", n)
+	}
+
+	if res := call(map[string]any{"query": "up"}); res.IsError {
+		t.Fatalf("expected success, got %v", res.Content)
+	}
+	last := requests()[1]
+	if _, ok := last.header["Accountid"]; ok {
+		t.Errorf("absent tenant must send no tenant headers: %v", last.header)
+	}
+}
