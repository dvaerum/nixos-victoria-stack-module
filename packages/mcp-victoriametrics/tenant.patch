+func TestSingleNodeToolsOfferTenantArgument(t *testing.T) {
+	cfg := newTenantTestConfig(t, "http://example.com", "single", "")
+	s := server.NewMCPServer("test", "test")
+	registerAllToolsForTest(s, cfg)
+	registered := s.ListTools()
+
+	for _, name := range tenantTools {
+		st, ok := registered[name]
+		if !ok {
+			t.Errorf("tool %q is not registered in single mode", name)
+			continue
+		}
+		prop, ok := st.Tool.InputSchema.Properties["tenant"].(map[string]any)
+		if !ok {
+			t.Errorf("tool %q has no tenant argument", name)
+			continue
+		}
+		if prop["type"] != "string" {
+			t.Errorf("tool %q: tenant must be a string, got %v", name, prop["type"])
+		}
+		for _, r := range st.Tool.InputSchema.Required {
+			if r == "tenant" {
+				t.Errorf("tool %q: tenant must be optional", name)
+			}
+		}
+	}
+	for _, name := range []string{"flags", "documentation", "test_rules"} {
+		if st, ok := registered[name]; ok {
+			if _, has := st.Tool.InputSchema.Properties["tenant"]; has {
+				t.Errorf("tool %q must not offer a tenant argument", name)
