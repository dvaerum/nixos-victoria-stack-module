index 0000000..f05748e
--- /dev/null
+++ b/cmd/mcp-victoriametrics/tools/tenant_test.go
@@ -0,0 +1,310 @@
+package tools
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+
+	"github.com/mark3labs/mcp-go/mcp"
+	"github.com/mark3labs/mcp-go/server"
+
+	"github.com/VictoriaMetrics/mcp-victoriametrics/cmd/mcp-victoriametrics/config"
+)
+
+func newTenantTestConfig(t *testing.T, entrypoint, instanceType, passthrough string) *config.Config {
+	t.Helper()
+	t.Setenv("VM_INSTANCE_ENTRYPOINT", entrypoint)
+	t.Setenv("VM_INSTANCE_TYPE", instanceType)
+	t.Setenv("VM_INSTANCE_BEARER_TOKEN", "static-token")
+	t.Setenv("MCP_PASSTHROUGH_HEADERS", passthrough)
+	t.Setenv("MCP_DISABLED_TOOLS", "") // set but empty: register every tool, including those disabled by default
+	cfg, err := config.InitConfig()
+	if err != nil {
+		t.Fatalf("failed to init config: %v", err)
+	}
+	return cfg
+}
+
+func TestGetToolReqTenant(t *testing.T) {
+	testCases := []struct {
+		name              string
+		args              map[string]any
+		expectedAccountID string
+		expectedProjectID string
+		expectError       bool
+	}{
+		{name: "absent", args: map[string]any{}},
+		{name: "empty", args: map[string]any{"tenant": ""}},
+		{name: "full", args: map[string]any{"tenant": "3:7"}, expectedAccountID: "3", expectedProjectID: "7"},
+		{name: "zero", args: map[string]any{"tenant": "0:0"}, expectedAccountID: "0", expectedProjectID: "0"},
+		{name: "account only", args: map[string]any{"tenant": "123"}, expectedAccountID: "123", expectedProjectID: "0"},
+		{name: "max uint32", args: map[string]any{"tenant": "4294967295:4294967295"}, expectedAccountID: "4294967295", expectedProjectID: "4294967295"},
+		{name: "leading zeros are normalized", args: map[string]any{"tenant": "03:007"}, expectedAccountID: "3", expectedProjectID: "7"},
+		{name: "path traversal", args: map[string]any{"tenant": "x/../y"}, expectError: true},
+		{name: "non-numeric", args: map[string]any{"tenant": "a:b"}, expectError: true},
+		{name: "too many colons", args: map[string]any{"tenant": "1:2:3"}, expectError: true},
+		{name: "negative", args: map[string]any{"tenant": "-1:2"}, expectError: true},
+		{name: "signed", args: map[string]any{"tenant": "+1:2"}, expectError: true},
+		{name: "overflow", args: map[string]any{"tenant": "4294967296:1"}, expectError: true},
+		{name: "surrounding space", args: map[string]any{"tenant": " 3:7"}, expectError: true},
+		{name: "header injection", args: map[string]any{"tenant": "3:7\r\nX-Evil: 1"}, expectError: true},
+		{name: "not a string", args: map[string]any{"tenant": float64(1)}, expectError: true},
+	}
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			tcr := mcp.CallToolRequest{}
+			tcr.Params.Arguments = tc.args
+			accountID, projectID, err := GetToolReqTenant(tcr)
+			if (err != nil) != tc.expectError {
+				t.Fatalf("expectError=%v, got err=%v", tc.expectError, err)
+			}
+			if accountID != tc.expectedAccountID || projectID != tc.expectedProjectID {
+				t.Errorf("expected %q:%q, got %q:%q", tc.expectedAccountID, tc.expectedProjectID, accountID, projectID)
+			}
+		})
+	}
+}
+
+func TestCreateSelectRequest_TenantHeaders(t *testing.T) {
+	cfg := newTenantTestConfig(t, "http://example.com", "single", "Authorization, AccountID")
+
+	t.Run("tenant argument becomes AccountID and ProjectID headers", func(t *testing.T) {
+		tcr := mcp.CallToolRequest{}
+		tcr.Params.Arguments = map[string]any{"tenant": "3:7"}
+		req, err := CreateSelectRequest(context.Background(), cfg, tcr, "api", "v1", "query")
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+		if got := req.Header.Get("AccountID"); got != "3" {
+			t.Errorf("AccountID: expected 3, got %q", got)
+		}
+		if got := req.Header.Get("ProjectID"); got != "7" {
+			t.Errorf("ProjectID: expected 7, got %q", got)
+		}
+		if req.URL.Path != "/api/v1/query" {
+			t.Errorf("single-node URL must stay tenant-free, got %q", req.URL.Path)
+		}
+	})
+
+	t.Run("no tenant argument sends no tenant headers", func(t *testing.T) {
+		req, err := CreateSelectRequest(context.Background(), cfg, mcp.CallToolRequest{}, "api", "v1", "query")
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+		if _, ok := req.Header["Accountid"]; ok {
+			t.Errorf("unexpected AccountID header: %v", req.Header)
+		}
+		if _, ok := req.Header["Projectid"]; ok {
+			t.Errorf("unexpected ProjectID header: %v", req.Header)
+		}
+	})
+
+	t.Run("no tenant argument keeps a forwarded AccountID header", func(t *testing.T) {
+		tcr := mcp.CallToolRequest{}
+		tcr.Header = http.Header{"Accountid": {"9"}}
+		req, err := CreateSelectRequest(context.Background(), cfg, tcr, "api", "v1", "query")
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+		if got := req.Header.Get("AccountID"); got != "9" {
+			t.Errorf("forwarded AccountID: expected 9, got %q", got)
+		}
+	})
+
+	t.Run("tenant argument wins over a forwarded header", func(t *testing.T) {
+		tcr := mcp.CallToolRequest{}
+		tcr.Header = http.Header{"Accountid": {"9"}, "Authorization": {"Bearer client-token"}}
+		tcr.Params.Arguments = map[string]any{"tenant": "3:7"}
+		req, err := CreateSelectRequest(context.Background(), cfg, tcr, "api", "v1", "query")
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+		if got := req.Header.Get("AccountID"); got != "3" {
+			t.Errorf("AccountID: argument must win over forwarded header, got %q", got)
+		}
+		if got := req.Header.Get("Authorization"); got != "Bearer client-token" {
+			t.Errorf("forwarded Authorization lost, got %q", got)
+		}
+	})
+
+	t.Run("invalid tenant is refused", func(t *testing.T) {
+		for _, bad := range []any{"x/../y", "a:b", "1:2:3", float64(1)} {
+			tcr := mcp.CallToolRequest{}
+			tcr.Params.Arguments = map[string]any{"tenant": bad}
+			if req, err := CreateSelectRequest(context.Background(), cfg, tcr, "api", "v1", "query"); err == nil {
+				t.Errorf("tenant %v: expected an error, got request %v", bad, req.URL)
+			}
+		}
+	})
+}
+
+func TestCreateSelectRequest_TenantArgumentIgnoredInClusterMode(t *testing.T) {
+	// In cluster mode the tenant selects the URL path (/select/<tenant>/...), not headers.
+	cfg := newTenantTestConfig(t, "http://example.com", "cluster", "")
+	tcr := mcp.CallToolRequest{}
+	tcr.Params.Arguments = map[string]any{"tenant": "3:7"}
+	req, err := CreateSelectRequest(context.Background(), cfg, tcr, "api", "v1", "query")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if req.URL.Path != "/select/3:7/prometheus/api/v1/query" {
+		t.Errorf("unexpected cluster path %q", req.URL.Path)
+	}
+	if _, ok := req.Header["Accountid"]; ok {
+		t.Errorf("cluster mode must not send tenant headers: %v", req.Header)
