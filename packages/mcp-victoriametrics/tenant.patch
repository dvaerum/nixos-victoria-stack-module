+// usesTenantHeaders reports whether the tenant of a request is picked with AccountID/ProjectID headers.
+// A single-node instance has no tenants of its own, but an authenticating proxy in front of it
+// (e.g. vmauth) selects the tenant from these headers. Cluster and cloud use the URL path instead.
+func usesTenantHeaders(cfg *config.Config) bool {
+	return cfg.IsSingle() && !cfg.IsCloud()
+}
+
+// withTenantHeaderOption appends the optional tenant argument to the options of a tool that queries a
+// single-node instance. The cluster and cloud tools declare their own path-based tenant argument.
+func withTenantHeaderOption(cfg *config.Config, options []mcp.ToolOption) []mcp.ToolOption {
+	if !usesTenantHeaders(cfg) {
+		return options
+	}
+	return append(options,
+		mcp.WithString("tenant",
+			mcp.Title("Tenant name (Account ID and Project ID)"),
+			mcp.Description("Name of the tenant for which the data will be displayed (format AccountID:ProjectID). "+
+				"Optional: only needed when the instance is behind an authenticating proxy that lets the caller choose among several tenants."),
+			mcp.Pattern(`^[0-9]+(:[0-9]+)?$`),
+		),
+	)
+}
+
+// GetToolReqTenant returns the AccountID and ProjectID of the optional tenant argument,
+// or empty strings when it is absent or empty.
+func GetToolReqTenant(tcr mcp.CallToolRequest) (string, string, error) {
+	tenant, err := GetToolReqParam[string](tcr, "tenant", false)
+	if err != nil {
+		return "", "", fmt.Errorf("failed to get tenant: %v", err)
+	}
+	if tenant == "" {
+		return "", "", nil
+	}
+	token, err := auth.NewToken(tenant)
+	if err != nil {
+		return "", "", fmt.Errorf("failed to parse tenant %q: %v", tenant, err)
+	}
+	return strconv.FormatUint(uint64(token.AccountID), 10), strconv.FormatUint(uint64(token.ProjectID), 10), nil
+}
